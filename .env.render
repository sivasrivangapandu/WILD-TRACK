# WildTrackAI Render Environment Template
# Copy settings to Render Dashboard Environment Variables

# Core Configuration
PYTHON_VERSION=3.10
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Model Loading
WILDTRACK_SKIP_MODEL_LOAD=0

# CORS - Update backend URL as needed after deployment
CORS_ORIGINS=https://wildtrack-frontend.onrender.com

# Authentication (Render auto-generates JWT_SECRET)
# JWT_SECRET=<auto-generated>

# External APIs (get these from respective services)
GEMINI_API_KEY=<your-gemini-key>
NINJA_API_KEY=<your-ninja-key>
CLOUDINARY_URL=<your-cloudinary-url>

# Optional: For detailed logging during startup
# FLASK_ENV=development
# LOG_LEVEL=DEBUG
